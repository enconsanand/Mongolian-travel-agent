# Copy to secret/.env before `make install`:
#   cp secret/.env.example secret/.env

ENV=local
PROJECT_NAME=Mongolian Travel Agent

# Comma-separated absolute URLs.
BACKEND_CORS_ORIGINS=http://localhost:3000

# At least 32 characters. Replace this before any shared or deployed environment.
JWT_SECRET=dev-only-change-me-jwt-secret-key-32b
ALGORITHM=HS256

TIMEZONE=Asia/Ulaanbaatar

# MongoDB: defaults to the compose `mongo` replica set (mongodb://mongo:27017/?directConnection=true).
# From your host machine use mongodb://localhost:27018/?directConnection=true
# For Atlas set the SRV URI (Atlas clusters are already replica sets).
# MONGO_URI=
# MONGO_DB_NAME=travel_mn

# Payments: sim = QPay adapter against the qpay-sim service (default). For QPay sandbox set PAYMENT_RAIL=qpay,
# QPAY_BASE_URL=https://merchant-sandbox.qpay.mn and the credentials QPay gives you. Never commit real ones.
# PAYMENT_RAIL=sim
# QPAY_BASE_URL=http://qpay-sim:8010
# QPAY_USERNAME=
# QPAY_PASSWORD=
# QPAY_INVOICE_CODE=
# Where the rail reaches our webhooks: http://back:8000 for qpay-sim; a public HTTPS URL (tunnel) for QPay.
# PUBLIC_BASE_URL=http://back:8000

# AP2 merchant of record. Without a key, local dev uses a throwaway one per process (checkouts stop verifying
# after a restart). Generate one with `make merchant-key`; required in stg/prod. Never commit it.
# MERCHANT_ID=merchant_mta
# MERCHANT_KEY_PEM=

# LLM model gateway. Routes per role are "provider:model", comma-separated fallbacks tried in order.
# Default is the offline `fake` provider (echo, no key). For Cloudflare Workers AI create an API token with
# "Workers AI: Read" and set the account id; free allocation is 10,000 neurons a day. Check with `make llm-smoke`.
# LLM_PLANNER=workers_ai:@cf/meta/llama-3.3-70b-instruct-fp8-fast
# LLM_WRITER=workers_ai:@cf/meta/llama-3.3-70b-instruct-fp8-fast
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Optional AI Gateway id (caching, logs, usage in the Cloudflare dashboard)
# CLOUDFLARE_AI_GATEWAY=
# If the model rejects response_format, use json_object or prompt (the gateway validates the JSON either way)
# LLM_JSON_MODE=json_schema

# oyu (https://dev.oyu.so): Anir speech-to-text, tsuurAI text-to-speech, Orchu mn<->en translation.
# Get a key at https://oyu.so/account/apikeys (starts with free credit). Without it the mic, "listen" and
# translation features answer 503 and everything else works.
# OYU_API_KEY=
# OYU_TTS_VOICE=mbspeech

# Uncomment to share rate limits and token revocation across workers.
# REDIS_URL=redis://redis:6379/0

# Password for seeded users (min 8 characters). If unset, the seeder prints a random one.
# SEED_DEV_PASSWORD=

NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
# Demo: shows a "Pay with Sim Bank" button on the checkout page (browser -> qpay-sim). Leave unset for real QPay.
NUXT_PUBLIC_QPAY_SIM_BASE=http://localhost:8010


# Browser key for the Maps JavaScript API (trip map). Restrict it to your site's referrers in Google Cloud.
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

OYU_API_KEY=""
LLM_PLANNER=oyu:oyuLLM
LLM_WRITER=oyu:oyuLLM
