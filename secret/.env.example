# Copy to secret/.env before `make install`:
#   cp secret/.env.example secret/.env

ENV=local
PROJECT_NAME=Mongolian Travel Agent

# Comma-separated absolute URLs.
BACKEND_CORS_ORIGINS=http://localhost:3000

# At least 32 characters. Replace this before any shared or deployed environment.
JWT_SECRET=dev-only-change-me-jwt-secret-key-32b
ALGORITHM=HS256

TIMEZONE=Asia/Ulaanbaatar

# MongoDB: defaults to the compose `mongo` replica set (mongodb://mongo:27017/?directConnection=true).
# From your host machine use mongodb://localhost:27018/?directConnection=true
# For Atlas set the SRV URI (Atlas clusters are already replica sets).
# MONGO_URI=
# MONGO_DB_NAME=travel_mn

# Uncomment to share rate limits and token revocation across workers.
# REDIS_URL=redis://redis:6379/0

# Password for seeded users (min 8 characters). If unset, the seeder prints a random one.
# SEED_DEV_PASSWORD=

NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
