{
  "name": "nuxt-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node .output/server/index.mjs",
    "build": "pnpm nuxt:prepare && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "nuxt:prepare": "nuxi prepare",
    "format:check": "prettier --check .",
    "format:write": "prettier --write --list-different .",
    "lint": "eslint . --fix",
    "typescript:check": "pnpm nuxi typecheck"
  },
  "lint-staged": {
    "*": [
      "eslint --fix"
    ],
    "*.{vue,js,ts,jsx,tsx,json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxtjs/robots": "^5.7.1",
    "@tailwindcss/vite": "^4.2.1",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "^14.2.1",
    "eslint": "^10.0.3",
    "nuxt": "^4.4.2",
    "ofetch": "^1.5.1",
    "primeicons": "^7.0.0",
    "tailwindcss": "^4.2.1",
    "uqr": "^0.1.2",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "esbuild": "^0.27.4",
    "jsdom": "^29.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
